{
  "name": "@truckconnect/sdk",
  "version": "0.1.0",
  "description": "TruckConnect Auth SDK — drop-in client for all TruckConnect apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./design-system": {
      "types": "./dist/design-system.d.ts",
      "import": "./dist/design-system.mjs",
      "require": "./dist/design-system.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/types.ts src/utils.ts src/design-system.ts src/hooks.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/server.ts src/types.ts src/utils.ts src/design-system.ts src/hooks.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "jose": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.1"
  }
}
